<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="cedrictaldu">
    <description>PSR-12 sur le code applicatif, les tests et les scripts.</description>

    <file>bin</file>
    <file>public</file>
    <file>src</file>
    <file>tests</file>
    <file>templates</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <!--
        PSR-12 impose des noms de méthode en camelCase. tests/CLAUDE.md impose
        que « le nom du test soit une phrase française qui décrit la règle
        métier » : test_une_oeuvre_vendue_ne_peut_pas_etre_ajoutee_au_panier().

        Les deux règles s'excluent. Le protocole de test fait autorité sur le
        nommage des tests, parce que ces noms sont lus comme une spécification
        exécutable — c'est ce que la sortie de PHPUnit donne à lire au client.
        L'exception est strictement limitée à tests/.
    -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Les gabarits sont du PHP natif melange a du HTML : la regle qui interdit
         le code apres la balise fermante n'y a pas de sens. -->
    <rule ref="PSR2.Files.ClosingTag">
        <exclude-pattern>templates/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.WhiteSpace.ScopeClosingBrace">
        <exclude-pattern>templates/*</exclude-pattern>
    </rule>
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <exclude-pattern>templates/*</exclude-pattern>
    </rule>
</ruleset>
