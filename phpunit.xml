<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutCoverageMetadata="false"
         failOnRisky="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">

    <!-- L'ordre reprend celui de la chaine d'integration continue de 07-tests-tdd.md §5 :
         unit -> integration -> functional -> security. La suite security est bloquante. -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
        <testsuite name="security">
            <directory>tests/Security</directory>
        </testsuite>
    </testsuites>

    <!-- La generation de derives d'images (tests media du lot 2) alloue de gros
         tampons GD ; cumulee au fil d'un run complet, la suite depasse les 128 Mo
         par defaut de PHP. On aligne PHPUnit sur PHPStan (memory-limit 512M) pour
         que `composer test` passe d'un bloc, sans dependre d'un reglage machine. -->
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
