# storage/ est HORS webroot dans la configuration de reference.
# Ce fichier est la ceinture et les bretelles du point 6 de 06-securite §5 :
# meme servi par erreur, rien ne s exécute et rien ne se liste.

Require all denied

# php_flag n'existe qu'avec mod_php (Thor) : sous PHP-FPM (production OVH),
# Apache la tient pour une commande inconnue et répond 500. RemoveHandler et
# SetHandler none coupent l'exécution dans les deux cas.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml
SetHandler none
Options -Indexes -ExecCGI
