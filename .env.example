# ---------------------------------------------------------------------------
# cedrictaldu.com — modele de configuration
#
# Copier en `.env` et renseigner. Le `.env` n'est JAMAIS commite (CLAUDE.md §6).
# Chaque variable listee ici est requise : `Core\Env` leve une exception au
# demarrage si l'une d'elles manque, elle n'est jamais remplacee en silence par
# une valeur par defaut (src/CLAUDE.md, section « Secrets, fichiers, erreurs »).
#
# Les lots ulterieurs ajoutent leurs propres variables (Stripe au lot 3, SMTP au
# lot 4). Elles seront documentees ici au moment ou elles sont utilisees.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------

# dev | preprod | prod. Tout ce qui n'est pas `prod` recoit `X-Robots-Tag: noindex`
# et interdit les cles Stripe de production (09-environnements §7).
APP_ENV=dev

# 1 uniquement hors production. En production : display_errors=0, page 500 nue
# portant un identifiant de correlation (06-securite §10).
APP_DEBUG=1

# URL absolue, prefixe compris. Sert aux liens canoniques, au sitemap, aux
# e-mails et aux URL de retour Stripe. JAMAIS reconstruite depuis l'en-tete Host
# (empoisonnement de cache — 09-environnements §3.8).
APP_URL=http://localhost:18120/cedric-taldu

# Prefixe de chemin, SEULE source de verite (09-environnements §3.1).
#   local et preprod : /cedric-taldu
#   production       : chaine vide
# Doit commencer par « / » et ne pas finir par « / ».
APP_BASE_PATH=/cedric-taldu

# Langue par defaut et langues servies, dans l'ordre de preference.
APP_DEFAULT_LOCALE=fr
APP_LOCALES=fr,en

# --- Proxy de confiance -----------------------------------------------------

# Adresses IP autorisees a positionner X-Forwarded-Proto / -Host / -Prefix / -For.
# Liste separee par des virgules. VIDE en production (aucun proxy devant Apache).
#   preprod : 192.168.1.195  (Heimdall)
# Un client qui n'est pas dans cette liste ne peut ni se declarer en HTTPS, ni
# changer l'hote percu, ni usurper une IP (09-environnements §4).
TRUSTED_PROXIES=

# --- Base de donnees --------------------------------------------------------

# Compte applicatif : SELECT, INSERT, UPDATE, DELETE uniquement.
# Ni DROP, ni CREATE, ni FILE, ni acces a une autre base (06-securite §1).
DB_HOST=db
DB_PORT=3306
DB_NAME=cedrictaldu
DB_USER=cedrictaldu
DB_PASSWORD=

# Compte distinct, employe uniquement par bin/migrate.php au deploiement.
DB_MIGRATION_USER=cedrictaldu_migrate
DB_MIGRATION_PASSWORD=

# Base dediee aux suites `integration` et `functional`, construite depuis les
# migrations (tests/CLAUDE.md, section « Base de test »). Jamais la base du site.
DB_TEST_NAME=cedrictaldu_test

# --- Secrets ----------------------------------------------------------------

# Poivre du hachage des adresses IP : SHA-256(ip + poivre). L'IP en clair n'est
# jamais stockee (06-securite §9). 32 octets aleatoires en hexadecimal :
#   php -r "echo bin2hex(random_bytes(32));"
# Le changer invalide toutes les empreintes existantes.
SECURITY_PEPPER=
