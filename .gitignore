# Secrets — jamais commités (CLAUDE.md §6)
/.env
/.env.*
!/.env.example

# Données d'exploitation — hors dépôt
/storage/cache/*
/storage/logs/*
/storage/sessions/*
/storage/uploads/*
!/storage/**/.gitkeep

# Dérivés d'images générés à l'upload
/public/media/*
!/public/media/.gitkeep

# Outillage
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
/build/

# Postes de travail
.DS_Store
Thumbs.db
/.idea/
/.vscode/

# Dépendances — liste blanche (lot 3)
#
# `composer install` n'est pas garanti sur l'hébergement mutualisé (CLAUDE.md) :
# ce qui tourne en production est donc ce qui est commité ici. Seules les
# dépendances de PRODUCTION le sont — PHPUnit, PHPStan et PHP_CodeSniffer pèsent
# 44 Mo et n'ont rien à faire sur le serveur.
#
# PIÈGE : `vendor/composer/autoload_files.php` fait un `require` À CHAUD des
# fichiers listés. Un dump généré AVEC les dépendances de développement y
# inscrit PHPUnit, PHPStan et deep-copy ; déployé tel quel, il fait échouer la
# toute première requête sur un fichier absent. Les cartes commitées doivent
# donc TOUJOURS venir de `composer dump:prod`. VendorTest le vérifie sur le
# contenu commité, pas sur la copie de travail.
#
# On ne suit que le CODE D'EXÉCUTION de chaque dépendance, pas ses docs ni ses
# tests. Motif concret : le README du SDK Stripe contient une clé « sk_test_… »
# d'exemple qui déclenche la protection anti-secret de GitHub. Ces fichiers
# n'ont de toute façon aucune utilité en production.
/vendor/*
!/vendor/autoload.php
!/vendor/composer/
!/vendor/phpmailer/phpmailer/
/vendor/phpmailer/phpmailer/*
!/vendor/phpmailer/phpmailer/src/
# PHPMailer charge ses traductions de messages d'erreur à l'exécution.
!/vendor/phpmailer/phpmailer/language/
!/vendor/phpmailer/phpmailer/composer.json
!/vendor/phpmailer/phpmailer/VERSION
!/vendor/phpmailer/phpmailer/LICENSE
!/vendor/stripe/
/vendor/stripe/stripe-php/*
!/vendor/stripe/stripe-php/lib/
!/vendor/stripe/stripe-php/composer.json
!/vendor/stripe/stripe-php/VERSION
!/vendor/stripe/stripe-php/LICENSE
!/vendor/stripe/stripe-php/init.php
